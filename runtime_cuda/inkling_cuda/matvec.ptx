// One warp per output row. Packed codes and scales stay on the device.
.version 7.8
.target sm_80
.address_size 64

.visible .entry packed_matvec(
    .param .u64 x_ptr, .param .u64 codes_ptr, .param .u64 scales_ptr,
    .param .u64 table_ptr, .param .u64 expert_ptr, .param .u64 y_ptr,
    .param .u32 rows, .param .u32 width, .param .u32 words,
    .param .u32 bits, .param .u32 group, .param .u32 hash_shift,
    .param .u32 hash_multiplier, .param .u32 x_div, .param .u32 lloyd,
    .param .u64 descriptors_ptr, .param .u64 expert_map_ptr, .param .u32 row_stride,
    .param .u32 groups, .param .u32 group_rows
)
{
    .reg .pred %p<9>;
    .reg .b32 %r<48>;
    .reg .b64 %rd<18>;
    .reg .f32 %f<9>;
    .reg .b16 %h;

    ld.param.u64 %rd1, [x_ptr];
    ld.param.u64 %rd2, [codes_ptr];
    ld.param.u64 %rd3, [scales_ptr];
    ld.param.u64 %rd4, [table_ptr];
    ld.param.u64 %rd5, [expert_ptr];
    ld.param.u64 %rd6, [y_ptr];
    ld.param.u32 %r1, [rows];
    ld.param.u32 %r2, [width];
    ld.param.u32 %r3, [words];
    ld.param.u32 %r4, [bits];
    ld.param.u32 %r5, [group];
    ld.param.u32 %r6, [hash_shift];
    ld.param.u32 %r7, [hash_multiplier];
    ld.param.u32 %r8, [x_div];
    ld.param.u32 %r9, [lloyd];
    ld.param.u64 %rd15, [descriptors_ptr];
    ld.param.u64 %rd16, [expert_map_ptr];

    // grid.z selects a token. Only routed projections have a per-token expert list.
    mov.u32 %r10, %ctaid.z;
    ld.param.u32 %r11, [row_stride];
    mul.wide.u32 %rd17, %r10, %r11;
    add.u64 %rd1, %rd1, %rd17;
    add.u64 %rd6, %rd6, %rd17;
    setp.ne.u64 %p8, %rd15, 0;
    @%p8 add.u64 %rd5, %rd5, %rd17;

    // grid.y is the routed slot; grid.x tiles four matrix rows.
    ld.param.u32 %r42, [group_rows];
    mov.u32 %r10, %ctaid.y;
    mov.u32 %r11, %ctaid.x;
    mov.u32 %r12, %tid.x;
    mov.u32 %r13, %laneid;
    shr.u32 %r14, %r12, 5;
    mad.lo.u32 %r15, %r11, 4, %r14;
    mov.u32 %r43, %r15;
    setp.ge.u32 %p1, %r15, %r1;
    @%p1 bra DONE;
    mad.wide.u32 %rd7, %r10, 4, %rd5;
    ld.global.s32 %r16, [%rd7];
    setp.lt.s32 %p2, %r16, 0;
    @%p2 bra DONE;

    // Each routed slot selects its own expert and packed format.
    setp.eq.u64 %p8, %rd15, 0;
    @%p8 bra PROJECT;
    // Pick the slab for the row group containing this output row.
    ld.param.u32 %r44, [groups];
    setp.eq.u32 %p8, %r44, 1;
    @%p8 bra LOOKUP;
    div.u32 %r45, %r15, %r42;
    rem.u32 %r43, %r15, %r42;
    mad.lo.u32 %r16, %r16, %r44, %r45;
LOOKUP:
    mad.wide.u32 %rd17, %r16, 8, %rd16;
    ld.global.v2.u32 {%r41, %r16}, [%rd17];
    mad.wide.u32 %rd17, %r41, 48, %rd15;
    ld.global.u64 %rd2, [%rd17];
    ld.global.u64 %rd3, [%rd17+8];
    ld.global.u64 %rd4, [%rd17+16];
    ld.global.u32 %r3, [%rd17+24];
    ld.global.u32 %r4, [%rd17+28];
    ld.global.u32 %r5, [%rd17+32];
    ld.global.u32 %r6, [%rd17+36];
    ld.global.u32 %r7, [%rd17+40];
    ld.global.u32 %r9, [%rd17+44];
PROJECT:
    mad.lo.u32 %r17, %r16, %r42, %r43;
    mul.lo.u32 %r18, %r17, %r3;
    mad.wide.u32 %rd8, %r18, 4, %rd2;
    div.u32 %r19, %r10, %r8;
    mul.lo.u32 %r20, %r19, %r2;
    mad.wide.u32 %rd9, %r20, 4, %rd1;
    setp.ne.u32 %p3, %r9, 0;
    setp.ne.u32 %p4, %r7, 0;
    mov.b32 %f1, 0;
    mov.u32 %r21, %r13;

LOOP:
    setp.ge.u32 %p5, %r21, %r2;
    @%p5 bra REDUCE;
    // Trellis states end at the group's last coefficient and run MSB first.
    // Lloyd-Max indices run forwards from the least significant bit.
    sub.u32 %r22, %r5, 1;
    and.b32 %r22, %r21, %r22;
    sub.u32 %r23, %r21, %r22;
    add.u32 %r23, %r23, %r5;
    sub.u32 %r24, %r2, %r23;
    selp.u32 %r24, %r21, %r24, %p3;
    mul.lo.u32 %r25, %r24, %r4;
    shr.u32 %r26, %r25, 5;
    and.b32 %r27, %r25, 31;
    mad.wide.u32 %rd10, %r26, 4, %rd8;
    ld.global.u32 %r28, [%rd10];
    add.u32 %r29, %r26, 1;
    setp.lt.u32 %p6, %r29, %r3;
    mov.u32 %r30, 0;
    @%p6 ld.global.u32 %r30, [%rd10+4];
    shr.u32 %r31, %r28, %r27;
    sub.u32 %r32, 32, %r27;
    shl.b32 %r33, %r30, %r32;
    or.b32 %r34, %r31, %r33;
    mov.u32 %r35, 1;
    shl.b32 %r36, %r35, %r4;
    sub.u32 %r36, %r36, 1;
    selp.u32 %r37, %r36, 4095, %p3;
    and.b32 %r38, %r34, %r37;
    @%p4 mul.lo.u32 %r38, %r38, %r7;
    @%p4 shr.u32 %r38, %r38, %r6;
    mad.lo.u32 %r39, %r38, %r5, %r22;
    mad.wide.u32 %rd11, %r39, 4, %rd4;
    mad.wide.u32 %rd12, %r21, 4, %rd9;
    ld.global.f32 %f2, [%rd11];
    ld.global.f32 %f3, [%rd12];
    fma.rn.f32 %f1, %f2, %f3, %f1;
    add.u32 %r21, %r21, 32;
    bra LOOP;

REDUCE:
    shfl.sync.bfly.b32 %f4, %f1, 16, 31, -1;
    add.f32 %f1, %f1, %f4;
    shfl.sync.bfly.b32 %f4, %f1, 8, 31, -1;
    add.f32 %f1, %f1, %f4;
    shfl.sync.bfly.b32 %f4, %f1, 4, 31, -1;
    add.f32 %f1, %f1, %f4;
    shfl.sync.bfly.b32 %f4, %f1, 2, 31, -1;
    add.f32 %f1, %f1, %f4;
    shfl.sync.bfly.b32 %f4, %f1, 1, 31, -1;
    add.f32 %f1, %f1, %f4;
    setp.ne.u32 %p7, %r13, 0;
    @%p7 bra DONE;
    mad.wide.u32 %rd13, %r17, 2, %rd3;
    ld.global.b16 %h, [%rd13];
    cvt.f32.f16 %f5, %h;
    mul.f32 %f6, %f1, %f5;
    mad.lo.u32 %r40, %r10, %r1, %r15;
    mad.wide.u32 %rd14, %r40, 4, %rd6;
    st.global.f32 [%rd14], %f6;
DONE:
    ret;
}

// packed_matvec_tokens: an unrouted projection for up to 8 tokens per block (grid.z tiles the tokens).
// Each weight is decoded once and multiplied into every token's sum.
.visible .entry packed_matvec_tokens(
    .param .u64 x_ptr, .param .u64 codes_ptr, .param .u64 scales_ptr,
    .param .u64 table_ptr, .param .u64 expert_ptr, .param .u64 y_ptr,
    .param .u32 rows, .param .u32 width, .param .u32 words,
    .param .u32 bits, .param .u32 group, .param .u32 hash_shift,
    .param .u32 hash_multiplier, .param .u32 x_div, .param .u32 lloyd,
    .param .u64 descriptors_ptr, .param .u64 expert_map_ptr, .param .u32 row_stride,
    .param .u32 groups, .param .u32 group_rows, .param .u32 tokens
)
{
    .reg .pred %p<9>;
    .reg .pred %pt<8>;
    .reg .b32 %r<52>;
    .reg .b64 %rd<24>;
    .reg .f32 %f<9>;
    .reg .f32 %acc<8>;
    .reg .f32 %xv<8>;
    .reg .b16 %h;

    ld.param.u64 %rd1, [x_ptr];
    ld.param.u64 %rd2, [codes_ptr];
    ld.param.u64 %rd3, [scales_ptr];
    ld.param.u64 %rd4, [table_ptr];
    ld.param.u64 %rd5, [expert_ptr];
    ld.param.u64 %rd6, [y_ptr];
    ld.param.u32 %r1, [rows];
    ld.param.u32 %r2, [width];
    ld.param.u32 %r3, [words];
    ld.param.u32 %r4, [bits];
    ld.param.u32 %r5, [group];
    ld.param.u32 %r6, [hash_shift];
    ld.param.u32 %r7, [hash_multiplier];
    ld.param.u32 %r9, [lloyd];
    ld.param.u32 %r11, [row_stride];
    ld.param.u32 %r42, [group_rows];
    ld.param.u32 %r46, [tokens];
    cvt.u64.u32 %rd18, %r11;

    // grid.z selects a tile of 8 tokens; %pt<t> marks the tokens that exist.
    mov.u32 %r10, %ctaid.z;
    mul.lo.u32 %r47, %r10, 8;
    sub.u32 %r46, %r46, %r47;
    mul.wide.u32 %rd17, %r47, %r11;
    add.u64 %rd1, %rd1, %rd17;
    add.u64 %rd6, %rd6, %rd17;
    setp.gt.u32 %pt0, %r46, 0;
    setp.gt.u32 %pt1, %r46, 1;
    setp.gt.u32 %pt2, %r46, 2;
    setp.gt.u32 %pt3, %r46, 3;
    setp.gt.u32 %pt4, %r46, 4;
    setp.gt.u32 %pt5, %r46, 5;
    setp.gt.u32 %pt6, %r46, 6;
    setp.gt.u32 %pt7, %r46, 7;

    mov.u32 %r11, %ctaid.x;
    mov.u32 %r12, %tid.x;
    mov.u32 %r13, %laneid;
    shr.u32 %r14, %r12, 5;
    mad.lo.u32 %r15, %r11, 4, %r14;
    mov.u32 %r43, %r15;
    setp.ge.u32 %p1, %r15, %r1;
    @%p1 bra DONE;
    ld.global.s32 %r16, [%rd5];
    setp.lt.s32 %p2, %r16, 0;
    @%p2 bra DONE;
    mad.lo.u32 %r17, %r16, %r42, %r43;
    mul.lo.u32 %r18, %r17, %r3;
    mad.wide.u32 %rd8, %r18, 4, %rd2;
    mov.u64 %rd9, %rd1;
    setp.ne.u32 %p3, %r9, 0;
    setp.ne.u32 %p4, %r7, 0;
    mov.b32 %acc0, 0;
    mov.b32 %acc1, 0;
    mov.b32 %acc2, 0;
    mov.b32 %acc3, 0;
    mov.b32 %acc4, 0;
    mov.b32 %acc5, 0;
    mov.b32 %acc6, 0;
    mov.b32 %acc7, 0;
    mov.u32 %r21, %r13;
LOOP:
    setp.ge.u32 %p5, %r21, %r2;
    @%p5 bra REDUCE;
    sub.u32 %r22, %r5, 1;
    and.b32 %r22, %r21, %r22;
    sub.u32 %r23, %r21, %r22;
    add.u32 %r23, %r23, %r5;
    sub.u32 %r24, %r2, %r23;
    selp.u32 %r24, %r21, %r24, %p3;
    mul.lo.u32 %r25, %r24, %r4;
    shr.u32 %r26, %r25, 5;
    and.b32 %r27, %r25, 31;
    mad.wide.u32 %rd10, %r26, 4, %rd8;
    ld.global.u32 %r28, [%rd10];
    add.u32 %r29, %r26, 1;
    setp.lt.u32 %p6, %r29, %r3;
    mov.u32 %r30, 0;
    @%p6 ld.global.u32 %r30, [%rd10+4];
    shr.u32 %r31, %r28, %r27;
    sub.u32 %r32, 32, %r27;
    shl.b32 %r33, %r30, %r32;
    or.b32 %r34, %r31, %r33;
    mov.u32 %r35, 1;
    shl.b32 %r36, %r35, %r4;
    sub.u32 %r36, %r36, 1;
    selp.u32 %r37, %r36, 4095, %p3;
    and.b32 %r38, %r34, %r37;
    @%p4 mul.lo.u32 %r38, %r38, %r7;
    @%p4 shr.u32 %r38, %r38, %r6;
    mad.lo.u32 %r39, %r38, %r5, %r22;
    mad.wide.u32 %rd11, %r39, 4, %rd4;
    mad.wide.u32 %rd12, %r21, 4, %rd9;
    ld.global.f32 %f2, [%rd11];
    mov.b32 %xv0, 0;
    @%pt0 ld.global.f32 %xv0, [%rd12];
    fma.rn.f32 %acc0, %f2, %xv0, %acc0;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv1, 0;
    @%pt1 ld.global.f32 %xv1, [%rd12];
    fma.rn.f32 %acc1, %f2, %xv1, %acc1;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv2, 0;
    @%pt2 ld.global.f32 %xv2, [%rd12];
    fma.rn.f32 %acc2, %f2, %xv2, %acc2;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv3, 0;
    @%pt3 ld.global.f32 %xv3, [%rd12];
    fma.rn.f32 %acc3, %f2, %xv3, %acc3;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv4, 0;
    @%pt4 ld.global.f32 %xv4, [%rd12];
    fma.rn.f32 %acc4, %f2, %xv4, %acc4;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv5, 0;
    @%pt5 ld.global.f32 %xv5, [%rd12];
    fma.rn.f32 %acc5, %f2, %xv5, %acc5;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv6, 0;
    @%pt6 ld.global.f32 %xv6, [%rd12];
    fma.rn.f32 %acc6, %f2, %xv6, %acc6;
    add.u64 %rd12, %rd12, %rd18;
    mov.b32 %xv7, 0;
    @%pt7 ld.global.f32 %xv7, [%rd12];
    fma.rn.f32 %acc7, %f2, %xv7, %acc7;
    add.u64 %rd12, %rd12, %rd18;
    add.u32 %r21, %r21, 32;
    bra LOOP;
REDUCE:
    shfl.sync.bfly.b32 %f4, %acc0, 16, 31, -1;
    add.f32 %acc0, %acc0, %f4;
    shfl.sync.bfly.b32 %f4, %acc0, 8, 31, -1;
    add.f32 %acc0, %acc0, %f4;
    shfl.sync.bfly.b32 %f4, %acc0, 4, 31, -1;
    add.f32 %acc0, %acc0, %f4;
    shfl.sync.bfly.b32 %f4, %acc0, 2, 31, -1;
    add.f32 %acc0, %acc0, %f4;
    shfl.sync.bfly.b32 %f4, %acc0, 1, 31, -1;
    add.f32 %acc0, %acc0, %f4;
    shfl.sync.bfly.b32 %f4, %acc1, 16, 31, -1;
    add.f32 %acc1, %acc1, %f4;
    shfl.sync.bfly.b32 %f4, %acc1, 8, 31, -1;
    add.f32 %acc1, %acc1, %f4;
    shfl.sync.bfly.b32 %f4, %acc1, 4, 31, -1;
    add.f32 %acc1, %acc1, %f4;
    shfl.sync.bfly.b32 %f4, %acc1, 2, 31, -1;
    add.f32 %acc1, %acc1, %f4;
    shfl.sync.bfly.b32 %f4, %acc1, 1, 31, -1;
    add.f32 %acc1, %acc1, %f4;
    shfl.sync.bfly.b32 %f4, %acc2, 16, 31, -1;
    add.f32 %acc2, %acc2, %f4;
    shfl.sync.bfly.b32 %f4, %acc2, 8, 31, -1;
    add.f32 %acc2, %acc2, %f4;
    shfl.sync.bfly.b32 %f4, %acc2, 4, 31, -1;
    add.f32 %acc2, %acc2, %f4;
    shfl.sync.bfly.b32 %f4, %acc2, 2, 31, -1;
    add.f32 %acc2, %acc2, %f4;
    shfl.sync.bfly.b32 %f4, %acc2, 1, 31, -1;
    add.f32 %acc2, %acc2, %f4;
    shfl.sync.bfly.b32 %f4, %acc3, 16, 31, -1;
    add.f32 %acc3, %acc3, %f4;
    shfl.sync.bfly.b32 %f4, %acc3, 8, 31, -1;
    add.f32 %acc3, %acc3, %f4;
    shfl.sync.bfly.b32 %f4, %acc3, 4, 31, -1;
    add.f32 %acc3, %acc3, %f4;
    shfl.sync.bfly.b32 %f4, %acc3, 2, 31, -1;
    add.f32 %acc3, %acc3, %f4;
    shfl.sync.bfly.b32 %f4, %acc3, 1, 31, -1;
    add.f32 %acc3, %acc3, %f4;
    shfl.sync.bfly.b32 %f4, %acc4, 16, 31, -1;
    add.f32 %acc4, %acc4, %f4;
    shfl.sync.bfly.b32 %f4, %acc4, 8, 31, -1;
    add.f32 %acc4, %acc4, %f4;
    shfl.sync.bfly.b32 %f4, %acc4, 4, 31, -1;
    add.f32 %acc4, %acc4, %f4;
    shfl.sync.bfly.b32 %f4, %acc4, 2, 31, -1;
    add.f32 %acc4, %acc4, %f4;
    shfl.sync.bfly.b32 %f4, %acc4, 1, 31, -1;
    add.f32 %acc4, %acc4, %f4;
    shfl.sync.bfly.b32 %f4, %acc5, 16, 31, -1;
    add.f32 %acc5, %acc5, %f4;
    shfl.sync.bfly.b32 %f4, %acc5, 8, 31, -1;
    add.f32 %acc5, %acc5, %f4;
    shfl.sync.bfly.b32 %f4, %acc5, 4, 31, -1;
    add.f32 %acc5, %acc5, %f4;
    shfl.sync.bfly.b32 %f4, %acc5, 2, 31, -1;
    add.f32 %acc5, %acc5, %f4;
    shfl.sync.bfly.b32 %f4, %acc5, 1, 31, -1;
    add.f32 %acc5, %acc5, %f4;
    shfl.sync.bfly.b32 %f4, %acc6, 16, 31, -1;
    add.f32 %acc6, %acc6, %f4;
    shfl.sync.bfly.b32 %f4, %acc6, 8, 31, -1;
    add.f32 %acc6, %acc6, %f4;
    shfl.sync.bfly.b32 %f4, %acc6, 4, 31, -1;
    add.f32 %acc6, %acc6, %f4;
    shfl.sync.bfly.b32 %f4, %acc6, 2, 31, -1;
    add.f32 %acc6, %acc6, %f4;
    shfl.sync.bfly.b32 %f4, %acc6, 1, 31, -1;
    add.f32 %acc6, %acc6, %f4;
    shfl.sync.bfly.b32 %f4, %acc7, 16, 31, -1;
    add.f32 %acc7, %acc7, %f4;
    shfl.sync.bfly.b32 %f4, %acc7, 8, 31, -1;
    add.f32 %acc7, %acc7, %f4;
    shfl.sync.bfly.b32 %f4, %acc7, 4, 31, -1;
    add.f32 %acc7, %acc7, %f4;
    shfl.sync.bfly.b32 %f4, %acc7, 2, 31, -1;
    add.f32 %acc7, %acc7, %f4;
    shfl.sync.bfly.b32 %f4, %acc7, 1, 31, -1;
    add.f32 %acc7, %acc7, %f4;
    setp.ne.u32 %p7, %r13, 0;
    @%p7 bra DONE;
    mad.wide.u32 %rd13, %r17, 2, %rd3;
    ld.global.b16 %h, [%rd13];
    cvt.f32.f16 %f5, %h;
    mad.wide.u32 %rd14, %r15, 4, %rd6;
    mul.f32 %f6, %acc0, %f5;
    @%pt0 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc1, %f5;
    @%pt1 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc2, %f5;
    @%pt2 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc3, %f5;
    @%pt3 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc4, %f5;
    @%pt4 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc5, %f5;
    @%pt5 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc6, %f5;
    @%pt6 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
    mul.f32 %f6, %acc7, %f5;
    @%pt7 st.global.f32 [%rd14], %f6;
    add.u64 %rd14, %rd14, %rd18;
DONE:
    ret;
}

// packed_matvec_routed_tokens: grid (row tiles, experts). Each block serves every (token, slot) of the batch
// that selected its expert, decoding each weight once per pass of up to 8 pairs.
.visible .entry packed_matvec_routed_tokens(
    .param .u64 x_ptr, .param .u64 selected_ptr, .param .u64 y_ptr,
    .param .u64 descriptors_ptr, .param .u64 expert_map_ptr,
